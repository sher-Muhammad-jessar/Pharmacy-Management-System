        <mxCell id="de4" value="HTTPS/JSON" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=9;" edge="1" parent="1" source="d_lb" target="d_app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="d_app" target="d_pool"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de6" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=9;" edge="1" parent="1" source="d_pool" target="d_db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="d_app" target="d_email"><mxGeometry relative="1" as="geometry" /></mxCell>
