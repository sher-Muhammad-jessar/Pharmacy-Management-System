        <mxCell id="note" value="Multi-branch: every client is scoped to a branch; the API enforces branch + role authorization. Mobile clients keep a local cache and synchronise when online." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="420" height="120" as="geometry" /></mxCell>
