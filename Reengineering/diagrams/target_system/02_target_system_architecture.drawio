        <mxCell id="x6" value="Caching" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=9;" vertex="1" parent="1"><mxGeometry x="60" y="797" width="140" height="30" as="geometry" /></mxCell>
        <mxCell id="x7" value="Auditing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=9;" vertex="1" parent="1"><mxGeometry x="210" y="797" width="140" height="30" as="geometry" /></mxCell>
        <mxCell id="x8" value="Scheduling" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=9;" vertex="1" parent="1"><mxGeometry x="360" y="797" width="140" height="30" as="geometry" /></mxCell>
