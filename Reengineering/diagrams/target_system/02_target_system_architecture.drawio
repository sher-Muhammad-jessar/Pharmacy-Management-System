        <mxCell id="ext" value="&lt;b&gt;EXTERNAL INTEGRATIONS&lt;/b&gt;&lt;br&gt;Email / SMS gateway &lt;font color=#6600cc&gt;NEW&lt;/font&gt;&lt;br&gt;Thermal / PDF printer&lt;br&gt;Payment gateway (optional)&lt;br&gt;Barcode / QR reader" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="730" width="390" height="110" as="geometry" /></mxCell>

