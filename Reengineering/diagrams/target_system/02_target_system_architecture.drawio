        <mxCell id="d_pay" value="Payment gateway (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="960" y="230" width="200" height="45" as="geometry" /></mxCell>

        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="d_desktop" target="d_lb"><mxGeometry relative="1" as="geometry" /></mxCell>
