        <mxCell id="s11" value="AnalyticsService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="450" y="390" width="160" height="34" as="geometry" /></mxCell>
        <mxCell id="s12" value="ReportService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="620" y="390" width="150" height="34" as="geometry" /></mxCell>
        <mxCell id="s13" value="MessageService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="780" y="390" width="150" height="34" as="geometry" /></mxCell>
        <mxCell id="s14" value="AuditService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="940" y="390" width="150" height="34" as="geometry" /></mxCell>
        <mxCell id="s15" value="BackupExportService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1100" y="390" width="180" height="34" as="geometry" /></mxCell>
        <mxCell id="s16" value="SchedulerService (expiry scan, alerts, backups) &lt;font color=#6600cc&gt;NEW&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="60" y="435" width="300" height="34" as="geometry" /></mxCell>

        <mxCell id="domain" value="&lt;b&gt;DOMAIN / MODEL LAYER&lt;/b&gt; — entities + business rules (pure, testable, no framework): Drug · StockBatch · Sale/SaleItem · PurchaseOrder/Item · AppUser/Role · Company · Customer · Prescription · Return · Notification · Branch · Message" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1320" height="55" as="geometry" /></mxCell>

        <mxCell id="dao" value="&lt;b&gt;DATA ACCESS LAYER (DAO / Repository) — the ONLY layer that talks to the DB&lt;/b&gt;&amp;nbsp;· parameterised SQL / ORM · connection pool · transaction manager · repositories per aggregate" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1320" height="55" as="geometry" /></mxCell>

        <mxCell id="db" value="&lt;b&gt;DATABASE LAYER&lt;/b&gt; — MySQL/MariaDB &lt;b&gt;pharmacy_ng&lt;/b&gt; (normalised, 3NF, utf8mb4) — see the Target Database Schema diagram" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1320" height="45" as="geometry" /></mxCell>

        <mxCell id="cross" value="&lt;b&gt;CROSS-CUTTING CONCERNS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="900" height="110" as="geometry" /></mxCell>
