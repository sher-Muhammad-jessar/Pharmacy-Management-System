        <mxCell id="d_desktop" value="&lt;b&gt;Desktop client&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="180" height="45" as="geometry" /></mxCell>
        <mxCell id="d_web" value="&lt;b&gt;Web browser&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="180" height="45" as="geometry" /></mxCell>
