        <mxCell id="d_lb" value="&lt;b&gt;API Gateway / Load balancer&lt;/b&gt;&lt;br&gt;HTTPS · JWT auth · rate limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="220" height="70" as="geometry" /></mxCell>

        <mxCell id="d_app" value="&lt;b&gt;Application server(s)&lt;/b&gt;&lt;br&gt;REST API + Services + Scheduler&lt;br&gt;(scalable, stateless)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="220" height="90" as="geometry" /></mxCell>

