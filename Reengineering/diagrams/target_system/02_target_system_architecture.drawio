        <mxCell id="x3" value="Security / RBAC / JWT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=9;" vertex="1" parent="1"><mxGeometry x="420" y="760" width="180" height="30" as="geometry" /></mxCell>
        <mxCell id="x4" value="Validation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=9;" vertex="1" parent="1"><mxGeometry x="610" y="760" width="140" height="30" as="geometry" /></mxCell>
