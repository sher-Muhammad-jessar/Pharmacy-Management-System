<mxfile host="app.diagrams.net" agent="SERE" version="22.1.0">
  <diagram id="target-arch" name="Target Architecture (Layered)">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;TARGET SYSTEM ARCHITECTURE — LAYERED / N-TIER (re-engineered)&lt;/b&gt;&lt;br&gt;dependencies point downwards only · UI holds no SQL and no business rules" style="text;html=1;align=center;fontSize=15;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1320" height="40" as="geometry" />
        </mxCell>

        <mxCell id="clients" value="&lt;b&gt;CLIENTS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1320" height="90" as="geometry" /></mxCell>
        <mxCell id="c_desktop" value="&lt;b&gt;Desktop app&lt;/b&gt;&lt;br&gt;JavaFX (replaces Swing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="250" height="50" as="geometry" /></mxCell>
        <mxCell id="c_web" value="&lt;b&gt;Web SPA&lt;/b&gt;&lt;br&gt;browser client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="250" height="50" as="geometry" /></mxCell>
        <mxCell id="c_mobile" value="&lt;b&gt;Mobile app&lt;/b&gt; &lt;font color=#6600cc&gt;NEW&lt;/font&gt;&lt;br&gt;offline-capable, syncs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="630" y="100" width="250" height="50" as="geometry" /></mxCell>
        <mxCell id="c_scan" value="&lt;b&gt;Barcode / QR scanner&lt;/b&gt; &lt;font color=#6600cc&gt;NEW&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="910" y="100" width="220" height="50" as="geometry" /></mxCell>

        <mxCell id="api" value="&lt;b&gt;API GATEWAY / REST API&lt;/b&gt; &lt;font color=#6600cc&gt;NEW&lt;/font&gt;&amp;nbsp;— authentication (JWT), rate limiting, versioning, routing to services (enables web + mobile + integrations)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1320" height="50" as="geometry" /></mxCell>

        <mxCell id="pres" value="&lt;b&gt;PRESENTATION LAYER&lt;/b&gt; — MVC/MVVM views, input validation, formatting (NO SQL, NO business rules)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1320" height="45" as="geometry" /></mxCell>

        <mxCell id="svc" value="&lt;b&gt;APPLICATION / SERVICE LAYER&lt;/b&gt; — use-case logic, validation, transactions, authorization checks" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="1320" height="190" as="geometry" /></mxCell>
        <mxCell id="s1" value="AuthService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="60" y="345" width="150" height="34" as="geometry" /></mxCell>
        <mxCell id="s2" value="UserService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="220" y="345" width="150" height="34" as="geometry" /></mxCell>
        <mxCell id="s3" value="InventoryService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="345" width="150" height="34" as="geometry" /></mxCell>
        <mxCell id="s4" value="BatchService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="540" y="345" width="150" height="34" as="geometry" /></mxCell>
        <mxCell id="s5" value="SalesService (POS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="700" y="345" width="150" height="34" as="geometry" /></mxCell>
        <mxCell id="s6" value="PurchaseService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="860" y="345" width="150" height="34" as="geometry" /></mxCell>
        <mxCell id="s7" value="ReturnService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1020" y="345" width="150" height="34" as="geometry" /></mxCell>
        <mxCell id="s8" value="PrescriptionService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1180" y="345" width="160" height="34" as="geometry" /></mxCell>
        <mxCell id="s9" value="CustomerLoyaltyService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="190" height="34" as="geometry" /></mxCell>
