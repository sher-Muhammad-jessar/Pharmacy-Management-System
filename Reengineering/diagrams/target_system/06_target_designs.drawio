        <mxCell id="m9" value="9: decrementBatch(batch, qty)" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="10: UPDATE stock_batch SET quantity=quantity-qty" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="p4" target="p7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="11: update loyalty + write audit_log" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="p3" target="p5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="12: COMMIT" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="p3" target="p7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m13" value="13: invoice (print / PDF)" style="html=1;endArrow=open;dashed=1;fontSize=9;strokeColor=#666666;" edge="1" parent="1" source="p3" target="p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="alt" value="alt [insufficient stock / expired / payment failure] → rollback, no partial sale" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="230" y="600" width="600" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
