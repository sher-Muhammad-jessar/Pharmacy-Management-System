        <mxCell id="p4" value="Low stock: SUM(batch.qty) ≤ drug.reorder_level → notification(LOW_STOCK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="350" width="290" height="50" as="geometry" /></mxCell>
