        <mxCell id="d4" value="More items?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="605" width="160" height="75" as="geometry" /></mxCell>
