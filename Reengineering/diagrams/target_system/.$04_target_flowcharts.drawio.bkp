        <mxCell id="p2" value="Verify prescription (FR-22)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="310" width="200" height="55" as="geometry" /></mxCell>
        <mxCell id="d3" value="Stock available&#10;(sum batches)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="410" width="180" height="85" as="geometry" /></mxCell>
        <mxCell id="io2" value="Reject — insufficient stock" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="420" width="200" height="60" as="geometry" /></mxCell>
