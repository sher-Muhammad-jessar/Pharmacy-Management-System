        <mxCell id="s" value="&lt;b&gt;START&lt;/b&gt;&lt;br&gt;(daily timer)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="150" height="45" as="geometry" /></mxCell>
