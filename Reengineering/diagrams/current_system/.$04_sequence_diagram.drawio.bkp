            <Array as="points">
              <mxPoint x="420" y="170" />
              <mxPoint x="420" y="195" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sm3" value="3: check_Bill() — duplicate barcode+qty?" style="html=1;endArrow=block;strokeColor=#333333;fontSize=10;rounded=1;" edge="1" parent="1" source="s_bill" target="s_bill">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="215" />
              <mxPoint x="420" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sm4" value="4: connect()" style="html=1;endArrow=block;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="s_bill" target="s_conn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm5" value="5: Connection (return)" style="html=1;endArrow=open;dashed=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="s_conn" target="s_bill">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm6" value="6: SELECT BARCODE,NAME,TYPE,DOSE,SELLING_PRICE,QUANTITY,EXPIRY FROM drugs WHERE BARCODE=&#39;&lt;input&gt;&#39;" style="html=1;endArrow=block;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="s_bill" target="s_drugs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm7" value="7: row (return)" style="html=1;endArrow=open;dashed=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="s_drugs" target="s_bill">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm8" value="8: alt [EXPIRY=&quot;Expired&quot;] → offer Renew_Validity  |  else → continue" style="html=1;endArrow=block;strokeColor=#333333;fontSize=10;rounded=1;" edge="1" parent="1" source="s_bill" target="s_bill">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="330" />
              <mxPoint x="420" y="355" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sm9" value="9: INSERT INTO sales (BARCODE,NAME,TYPE,DOSE,QUANTITY,PRICE,AMOUNT,DATE) ..." style="html=1;endArrow=block;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="s_bill" target="s_sales">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm10" value="10: UPDATE drugs SET QUANTITY = rest_drug WHERE BARCODE=&#39;&lt;input&gt;&#39;   (decrement stock)" style="html=1;endArrow=block;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="s_bill" target="s_drugs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm11" value="11: INSERT INTO history_sales (USER_NAME,...,DATE,TIME) ..." style="html=1;endArrow=block;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="s_bill" target="s_hist">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm12" value="12: get_Total() — SELECT AMOUNT FROM sales  (loop; accumulation)" style="html=1;endArrow=block;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="s_bill" target="s_sales">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm13" value="13: AMOUNT rows (return)" style="html=1;endArrow=open;dashed=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="s_sales" target="s_bill">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm14" value="14: show bill lines + total on the form" style="html=1;endArrow=open;dashed=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="s_bill" target="s_emp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;Defects visible in this flow&lt;/b&gt;&#xa;• &lt;b&gt;NOT transactional&lt;/b&gt; — INSERT sales, UPDATE drugs, INSERT history_sales run in AUTO-COMMIT: a failure can leave stock and history inconsistent.&#xa;• All three SQL statements are &lt;b&gt;string-concatenated&lt;/b&gt; (injection).&#xa;• &lt;code&gt;get_Total()&lt;/code&gt; accumulates inside the loop → the running total is added repeatedly (known bug).&#xa;• Quantity 0 only warns; the sale still proceeds.&#xa;• &quot;New_Bill&quot; / &quot;Cancel&quot; issue a blanket &lt;code&gt;DELETE FROM sales&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="560" width="660" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
