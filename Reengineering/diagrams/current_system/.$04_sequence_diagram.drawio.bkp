        <mxCell id="sm1" value="1: enter Barcode + Quantity, click &quot;Get_Bill&quot;" style="html=1;endArrow=block;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="s_emp" target="s_bill">
