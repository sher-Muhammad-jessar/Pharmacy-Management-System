        <mxCell id="db" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;SHARED DATABASE — `pharmacy` (MySQL / MariaDB) — single flat, denormalised store used by ALL modules&lt;/b&gt;&lt;br&gt;company · drugs · purchase · sales · history_sales · users · login · inbox · message_history · expiry (unused)" vertex="1">
