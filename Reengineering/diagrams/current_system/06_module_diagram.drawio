        <mxCell id="title" parent="1" style="text;html=1;align=center;fontSize=15;fontColor=#333333;" value="&lt;b&gt;MODULE DIAGRAM — HOW THE 8 RECOVERED MODULES ARE CONNECTED (current system)&lt;/b&gt;&lt;br&gt;Star topology: every module is reached through the Pharmacy dashboard hub; all share one flat database" vertex="1">
          <mxGeometry height="40" width="1320" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="m1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="&lt;b&gt;M1 — Authentication &amp;amp; Session&lt;/b&gt;&lt;br&gt;Login · Change_Password · changestyle" vertex="1">
